{
  "expo": {
    "name": "DocuGuard Admin",
    "slug": "docuguard-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "docuguardadmin",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/977a48ce-4ba5-4a9f-9679-415b3ace5fb8"
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.docuguard.admin",
      "adaptiveIcon": {
        "backgroundColor": "#142D4E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A192F"
        }
      ],
      "expo-secure-store",
      [
        "react-native-biometric-signature",
        {
          "faceIDUsageDescription": "Verify your DocuGuard administrator identity and authorize secure device signing."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/favicon.png",
          "color": "#142D4E",
          "sounds": []
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "977a48ce-4ba5-4a9f-9679-415b3ace5fb8"
      }
    }
  }
}
