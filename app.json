{
  "expo": {
    "scheme": "docuguard",
    "name": "DocuGuard",
    "slug": "DocuGuard",
    "version": "1.0.0",
    "icon": "./app/assets/icon.png",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/118057a8-ff30-4258-b9a4-096c617ae595"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.DocuGuard",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.DocuGuard",
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./app/assets/icon.png",
          "imageWidth": 100,
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./app/assets/icon.png"
          }
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow DocuGuard to use Face ID to unlock your secure documents."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DocuGuard to access your camera to scan secure identity and vault documents."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./app/assets/icon.png",
          "color": "#2563EB",
          "sounds": []
        }
      ],
      "react-native-document-scanner-plugin",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": "docuguard://"
      },
      "apiBaseUrl": "https://docuguard-api-onoj.onrender.com",
      "eas": {
        "projectId": "118057a8-ff30-4258-b9a4-096c617ae595"
      }
    }
  }
}
