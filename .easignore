# Learn more https://docs.expo.dev/guides/eas-build-reference/#easignore

# Version control
.git
.github
.gitignore

# Dependencies — EAS installs its own
node_modules

# Expo build artifacts
.expo
dist
web-build
expo-env.d.ts

# Build outputs and caches
build
*.log
.DS_Store
.idea
.vscode

# Android build artifacts — keep the bare project, drop the cache and outputs
android/.gradle
android/app/build
android/build
android/caches

# iOS — not tracked, safe to drop entirely
ios

# Backend — not part of the mobile build
DocuGuard-Server

# Local environment and secrets
.env
.env.local
.env.*.local
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
!android/app/debug.keystore

# TypeScript build info
*.tsbuildinfo

# Metro
.metro-health-check

# Other tooling
.kilo
.claude
docs