*.key
*.mobileprovision

# Android debug keystore. It is a well-known public key that ships in every
# React Native project and is already committed, so it MUST stay in the upload
# or EAS cannot sign the debug build. Release keystores are covered above.
*.keystore
!debug.keystore

Metro

.metro-health-check/*

Debug

npm-debug.*
yarn-debug.*
yarn-error.*

