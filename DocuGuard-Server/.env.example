# DocuGuard Backend - Production Environment Variables
# Copy this to .env and fill in your values
# NEVER commit actual .env files with real secrets!

# =========================================================================
# Application
# =========================================================================
NODE_ENV=production
PORT=3000

# Generate a strong random secret for JWT signing (min 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# =========================================================================
# Database (PostgreSQL) - Use Render Managed PostgreSQL or Supabase
# =========================================================================
# Render PostgreSQL (recommended): Get these from Render Dashboard > Database > Info
DB_HOST=your-db-host.oregon-postgres.render.com
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=docuguard
DB_PORT=5432
DB_SSL=true

# Alternative: Supabase PostgreSQL
# DB_HOST=db.your-project.supabase.co
# DB_USER=postgres
# DB_PASSWORD=your-supabase-db-password
# DB_NAME=postgres
# DB_PORT=5432
# DB_SSL=true

# =========================================================================
# Supabase (Database + Auth + Storage)
# =========================================================================
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks

# =========================================================================
# Supabase Storage
# =========================================================================
# Create a bucket named "documents" in Supabase Dashboard > Storage
# Set bucket to PUBLIC for direct file access
# No additional env vars needed - uses SUPABASE_URL above

# =========================================================================
# Email (for verification emails, password resets) - Resend
# =========================================================================
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=DocuGuard <noreply@yourdomain.com>

# =========================================================================
# App URLs (for email verification links)
# =========================================================================
# Base URL of your deployed backend (for email links)
APP_BASE_URL=https://your-app.onrender.com
# Deep link scheme for your mobile app (from app.json scheme)
APP_DEEPLINK_SCHEME=docuguard

# =========================================================================
# Azure Document Intelligence (for OCR processing)
# =========================================================================
# Get these from Azure Portal > Document Intelligence Resource > Keys & Endpoint
AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_KEY=your-azure-key

# =========================================================================
# Firebase (for push notifications)
# =========================================================================
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =========================================================================
# Debug Logging (optional)
# =========================================================================
# Set to a file path to enable debug log persistence (Render: /tmp/docuguard_debug.log)
DEBUG_LOG_FILE=/tmp/docuguard_debug.log

