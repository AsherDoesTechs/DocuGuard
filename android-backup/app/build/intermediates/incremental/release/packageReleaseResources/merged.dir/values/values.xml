    <color name="iconBackground">#ffffff</color>
    <color name="notification_icon_color">#4F46E5</color>
    <color name="splashscreen_background">#F8FBFF</color>
    <integer name="react_native_dev_server_port">8081</integer>
    <string name="app_name">DocuGuard</string>
